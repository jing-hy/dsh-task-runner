{
  "name": "dsh-task-runner",
  "version": "1.1.0",
  "description": "DSH plugin: project/task dual-mode workspaces. Tasks skip the workspace picker — every task conversation gets a fresh scratch directory under D:\\dsh_working\\<name>-<timestamp> (Codex-style), while projects keep the existing workspace flow. Ships an idempotent host patch (script) for the official 'dsh-client-ui-workspace' sidebar (EAC 4.1 legacy and 4.2 rc.7).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./registry": "./lib/registry.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/patch-sidebar-always-visible.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:smoke": "node test/host-smoke.mjs && node test/client-load-sim.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "task",
    "scratch",
    "project"
  ],
  "license": "MIT",
  "author": "jing-hy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jing-hy/dsh-task-runner.git"
  },
  "bugs": {
    "url": "https://github.com/jing-hy/dsh-task-runner/issues"
  },
  "homepage": "https://github.com/jing-hy/dsh-task-runner#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
